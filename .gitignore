# --- Build output ---
target/
bin/
out/
build/
dist/
*.class
*.jar
*.war

# --- Maven ---
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# --- SQLite ---
# The database is generated by the seeder on first run, so it is never committed.
# -wal and -shm appear when SQLite runs in write-ahead-logging mode.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
smartbudget.db*

# --- Secrets ---
# The Groq API key lives here. Committing it would leak a live credential,
# so the file is ignored and only a committed .example template documents it.
config.properties
!config.properties.example
.env
.env.*
!.env.example
*.key
secrets.properties

# --- IDE: IntelliJ IDEA ---
.idea/
*.iml
*.ipr
*.iws

# --- IDE: Eclipse ---
.settings/
.classpath
.project
.factorypath
.apt_generated/

# --- IDE: VS Code ---
.vscode/
!.vscode/settings.json
!.vscode/extensions.json

# --- IDE: NetBeans ---
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# --- JVM crash logs ---
hs_err_pid*.log
replay_pid*.log
*.hprof

# --- Logs and temp files ---
*.log
*.tmp
*.bak
*~

# --- OS noise ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
